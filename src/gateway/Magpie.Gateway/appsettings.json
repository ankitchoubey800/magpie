{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "accounts-api": {
        "ClusterId": "accounts",
        "Match": {
          "Path": "/api/accounts/{**catch-all}"
        }
      },
      "web": {
        "ClusterId": "web",
        "Order": 1000,
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "accounts": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "web": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5173/"
          }
        }
      }
    }
  }
}
