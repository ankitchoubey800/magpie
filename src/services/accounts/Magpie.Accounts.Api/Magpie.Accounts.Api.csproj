<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Magpie.Accounts.Application\Magpie.Accounts.Application.csproj" />
    <ProjectReference Include="..\Magpie.Accounts.Infrastructure\Magpie.Accounts.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\shared\Magpie.Defaults\Magpie.Defaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.*" />
  </ItemGroup>

  <!-- Needed only by the "dotnet ef" command-line tool that creates migrations.
       PrivateAssets=all keeps it out of the published service. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>3f02d4f3-d99e-4e58-926a-242ccc3ca2e5</UserSecretsId>
  </PropertyGroup>

</Project>
