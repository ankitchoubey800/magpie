{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Collector": {
    "ContactUrl": "",
    "TickSeconds": 30,
    "MaxParallelSources": 4,
    "PerSourceTimeoutSeconds": 20,
    "HttpTimeoutSeconds": 8,
    "MaxItemsPerFetch": 50,
    "MaxResponseBytes": 2000000
  }
}
