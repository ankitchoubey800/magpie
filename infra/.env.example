# Copy this file to ".env" (same folder) and change the password.
#   cp infra/.env.example infra/.env
# ".env" is listed in .gitignore, so your real values never reach GitHub.
POSTGRES_DB=magpie_accounts
POSTGRES_USER=magpie
POSTGRES_PASSWORD=change-me-laptop-only

# Sign-up, sign-in and reset requests allowed per network address per minute.
AUTH_REQUESTS_PER_MINUTE=10

# "Continue with Google". Leave empty to keep it switched off.
# Get the two values from the Google Cloud console (see Chapter 3, Step 8).
# The secret is a real secret: it belongs here in .env, never in Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Collector ---
# A page where the owner of a site we visit can learn about this collector and
# contact its operator. It is sent with every request the collector makes.
# CHANGE THIS to a page of your own (your repository's README is fine).
COLLECTOR_CONTACT_URL=https://github.com/ankitchoubey800/magpie

# How often the collector looks for sources that are due (seconds).
COLLECTOR_TICK_SECONDS=30

# Which list of sources to load. Uncomment the second line for the week 5 experiment.
COLLECTOR_SEED_FILE=./seed/sources.json
# COLLECTOR_SEED_FILE=./experiments/bad-sources/sources.json
